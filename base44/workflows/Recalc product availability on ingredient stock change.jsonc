{
  "name": "Recalc product availability on ingredient stock change",
  "description": "When an ingredient's stock changes, recompute affected products and notify kitchen if any go out of stock",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"stock\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Ingredient"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recalc_product_availability_on_ingredient_stock_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recalculateProductAvailability",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recalculateProductAvailability"
  }
}